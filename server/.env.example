PORT=4000

# Local con Docker, o la connection string de Neon/Supabase.
# El SSL se activa solo según el host: localhost sin SSL, el resto con SSL verificado.
DATABASE_URL=postgres://uniplanner:uniplanner@localhost:5432/uniplanner

# Mínimo 32 caracteres aleatorios. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Orígenes permitidos por CORS, separados por coma si hay más de uno.
CLIENT_URL=http://localhost:5173
